# Copie para `.env` e preencha. Nunca commite o `.env`.
#
# ATENÇÃO: o nome da variável é VITE_SUPABASE_PUBLISHABLE_KEY.
# Um exemplo antigo usava VITE_SUPABASE_ANON_KEY, que o código não lê —
# quem seguia o exemplo antigo subia o app em branco.

# ── Obrigatórias (frontend) ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable_ou_anon
VITE_SUPABASE_PROJECT_ID=SEU-PROJETO

# ── Opcionais (frontend) ───────────────────────────────────────────────────
# Sem DSN o Sentry não é inicializado e nenhum erro de produção é capturado.
VITE_SENTRY_DSN=
# Fração de transações enviadas ao Sentry. Padrão 0.1 — nunca deixe em 1.0.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Edge Functions (Supabase · `supabase secrets set`) ─────────────────────
# SUPABASE_SERVICE_ROLE_KEY  — nunca exponha no frontend
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# APP_ORIGIN                 — origem padrão dos redirecionamentos de checkout
# ALLOWED_ORIGINS            — origens extras, separadas por vírgula
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT
# LOVABLE_API_KEY
#
# IDs do Stripe (opcional — há fallback para os valores de produção em
# supabase/functions/_shared/billing.ts). Defina para criar um ambiente de
# homologação sem tocar em código:
# STRIPE_PRODUCT_PREMIUM / STRIPE_PRODUCT_PROFESSIONAL / STRIPE_PRODUCT_LIFETIME
# STRIPE_PRICE_PREMIUM / STRIPE_PRICE_PREMIUM_ANNUAL
# STRIPE_PRICE_PROFESSIONAL / STRIPE_PRICE_PROFESSIONAL_ANNUAL / STRIPE_PRICE_LIFETIME
