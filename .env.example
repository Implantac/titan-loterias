# Copie para `.env` para desenvolvimento local.
#
# Estas três variáveis são PÚBLICAS por desenho: vão embutidas no bundle e são
# enviadas pelo navegador em toda requisição. Quem protege os dados é o Row
# Level Security do Postgres, não o sigilo delas.
#
# Se você NÃO criar o .env, o build e os testes usam o fallback de
# `supabase-env.ts` (o projeto de produção). Defina-as aqui para apontar para
# outro projeto — staging, por exemplo.
VITE_SUPABASE_URL="https://SEU-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-publishable-key-anon"
VITE_SUPABASE_PROJECT_ID="SEU-PROJECT-REF"

# Opcional — sem isto o Sentry fica inerte e erros de produção não são reportados.
VITE_SENTRY_DSN=""
VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"
